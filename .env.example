# Copy to .env. With no key at all, the checker runs rules-only (clear scam patterns only).

# FREE option: Gemini. Get a key at https://aistudio.google.com/apikey (no card needed).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_RPM=10                   # stay under the free tier's requests-per-minute limit

# Paid option: Claude. Used automatically when set (LLM_PROVIDER=auto).
ANTHROPIC_API_KEY=
CHECKER_CLAUDE_MODEL=claude-opus-5-5
CHECKER_CLAUDE_EFFORT=low       # named CHECKER_ so it never collides with Claude Code's own CLAUDE_EFFORT

LLM_PROVIDER=auto               # auto | anthropic | gemini | none

# Verdict policy (chosen on the golden set; see README)
SAMPLES=2
SCAM_THRESHOLD=0.70
GENUINE_THRESHOLD=0.80

RATE_LIMIT_PER_HOUR=30
LOG_PATH=data/logs/events.jsonl
STATS_TOKEN=                    # if set, GET /api/stats needs the header X-Stats-Token

# Optional services (off when empty)
DATABASE_URL=                   # Postgres for the event log, e.g. postgresql://user:pw@host/db?sslmode=require
SAFE_BROWSING_API_KEY=          # Google Safe Browsing Lookup API key (non-commercial use)
